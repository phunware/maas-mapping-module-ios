    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your precise location is used to show your position on the map, get directions, estimate travel times, turn by turn directions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su ubicación precisa se utiliza para mostrar su posición en el mapa, obtener direcciones, estimar los tiempos de viaje, indicaciones detalladas."
          }
        },
